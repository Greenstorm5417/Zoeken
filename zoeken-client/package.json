{
  "name": "zoeken-client",
  "private": true,
  "version": "1.4.5",
  "description": "Zoeken web UI (React SPA)",
  "author": "Greenstorm <sdussinger1007@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenstorm5417/zoeken.git",
    "directory": "zoeken-client"
  },
  "homepage": "https://github.com/Greenstorm5417/zoeken#readme",
  "bugs": {
    "url": "https://github.com/Greenstorm5417/zoeken/issues"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "sync-data": "bun scripts/sync-client-data.mjs",
    "build": "bun run sync-data && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:types": "tsc --noEmit",
    "check:generated": "node ./scripts/assert-generated-native.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": ">=8.5.23",
    "nanoid": ">=3.3.16"
  }
}
