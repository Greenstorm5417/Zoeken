# Example env for docker compose. Copy to .env and fill in values.
#
#   cp .env.example .env
#   # then set APP_SECRET_KEY (compose refuses to start without it)

# Required. Generate with: openssl rand -hex 24
APP_SECRET_KEY=

APP_PUBLIC_INSTANCE=true
ZOEKEN_PORT=8888

# Optional SQLite pool size (default 4)
# APP_SQLITE_MAX_CONNECTIONS=4

# --- PostgreSQL profile (`docker compose --profile postgres up -d`) ---
# Set a real password before production. The compose default
# `change-me-before-production` is a placeholder only.
# POSTGRES_PASSWORD=
# APP_STORAGE_BACKEND=postgres
# APP_POSTGRES_URL=postgres://zoeken:YOUR_PASSWORD@postgres:5432/zoeken
